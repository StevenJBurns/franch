```gitignore
# Dependencies
node_modules/

# Build output
coverage/
build/
dist/

# Tool caches
.eslintcache
.nyc_output/
.cache/
.vite/

# Environment variables
!.env.example
.env.*
.env

# Logs
yarn-debug.log*
npm-debug.log*
bun-debug.log*
*.log
logs/

# Runtime artifacts
*.pid.lock
*.pid
pids/

# Local data
data/development/
data/local/

# TypeScript
*.tsbuildinfo

# Operating system
$RECYCLE.BIN/
Desktop.ini
Thumbs.db
.DS_Store
._*

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
